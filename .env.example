# Stellar SolarGrid - Docker Compose Environment Variables

# ── Stellar Contract ──────────────────────────────────────────────────────────
# The deployed Soroban smart contract ID
CONTRACT_ID=YOUR_CONTRACT_ID_HERE

# Stellar network to connect to (testnet | mainnet)
STELLAR_NETWORK=testnet

# ── Admin Keypair ─────────────────────────────────────────────────────────────
# Secret key used to sign on-chain transactions — NEVER commit the real value
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_KEY_HERE

# Public key of the admin account (used by GET /api/stats for revenue lookup)
ADMIN_ADDRESS=YOUR_ADMIN_PUBLIC_KEY_HERE

# API key for admin-only backend endpoints
ADMIN_API_KEY=change-me-in-production

# ── MQTT ──────────────────────────────────────────────────────────────────────
# MQTT broker URL used by backend and IoT bridge
MQTT_BROKER=mqtt://mqtt:1883

# Units threshold below which a low-balance webhook is triggered
LOW_BALANCE_THRESHOLD=1000000

# ── Frontend build args ───────────────────────────────────────────────────────
# Contract ID exposed to the Vite frontend build
VITE_CONTRACT_ID=YOUR_CONTRACT_ID_HERE

# Frontend origin used by backend CORS (change for production)
FRONTEND_ORIGIN=http://localhost:5173

# ── Rate limiting / reverse proxy ─────────────────────────────────────────────
# Number of reverse proxies (load balancer, CDN, nginx, etc.) in front of the
# backend. Used for Express's 'trust proxy' setting so req.ip — and therefore
# IP-based rate limiting — is derived from the correct X-Forwarded-For entry.
# Leave at 0 if the backend is reached directly. NEVER set this to a value
# that trusts an untrusted hop: doing so lets clients spoof X-Forwarded-For
# and bypass rate limits entirely.
TRUST_PROXY_HOPS=0

# Global quotas are enforced on every backend endpoint. Redis is required for
# counters shared across multiple backend replicas; without it, counters are
# process-local. API keys use read/write/admin permission tiers.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_USER_READ_MAX=300
RATE_LIMIT_USER_WRITE_MAX=600
RATE_LIMIT_USER_ADMIN_MAX=1000
# Set REDIS_URL to a provisioned Redis instance for shared multi-replica quotas.

# Transactional email (#882). Provider can be resend, sendgrid, or log.
EMAIL_PROVIDER=log
EMAIL_FROM=SolarGrid <notifications@example.com>
EMAIL_PREFERENCES_SECRET=change-me-in-production
EMAIL_PREFERENCES_BASE_URL=http://localhost:3001

# Grid stability thresholds. Defaults assume a 230 V / 50 Hz nominal grid.
GRID_VOLTAGE_MIN_V=207
GRID_VOLTAGE_MAX_V=253
GRID_FREQUENCY_MIN_HZ=49.5
GRID_FREQUENCY_MAX_HZ=50.5
