# Required environment variables
PORT=3001
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional multiple RPC endpoints for failover (comma-separated):
# STELLAR_RPC_URLS=https://soroban-testnet.stellar.org,https://rpc2.stellar.org,https://rpc3.stellar.org
CONTRACT_ID=YOUR_CONTRACT_ID_HERE
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_KEY_HERE
MQTT_BROKER=mqtt://mqtt:1883

# Must be set — server refuses to start without it (startup fatal).
# Use a random secret with at least 32 characters of entropy in production,
# e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-in-production

# Optional environment variables with defaults
ADMIN_PUBLIC_KEY=YOUR_ADMIN_PUBLIC_KEY_HERE
# Public key of the admin account — used by GET /api/stats to fetch provider revenue
ADMIN_ADDRESS=YOUR_ADMIN_PUBLIC_KEY_HERE
TELECOM_WEBHOOK_SECRET=YOUR_TELECOM_WEBHOOK_SECRET_HERE
TX_TIMEOUT_MS=30000
TX_MAX_ATTEMPTS=15
TX_POLL_INTERVAL_MS=2000

# Request timeout — maximum time a request can take before returning 504.
# Accepts values like '15s', '30s', '1m'. Default: 15s
REQUEST_TIMEOUT=15s

# Maximum allowed JSON/URL-encoded body size. Default: 100kb
# Accepts values like '50kb', '1mb'. Requests exceeding this return 413.
REQUEST_BODY_LIMIT=100kb

# Max reconnect attempts for IoT bridge MQTT connection before alerting and stopping (default: 10)
MQTT_MAX_RECONNECT_ATTEMPTS=10

# The MQTT client (backend/src/iot/mqttClient.ts) registers a last-will-and-
# testament: on unclean disconnect, the broker publishes a retained
# { "status": "offline" } message to solargrid/bridge/status on our behalf,
# so subscribers can detect the bridge going down without waiting for a
# heartbeat timeout. A retained { "status": "online" } message is published
# to the same topic once we connect. No extra configuration is required.

# Low-balance webhook configuration (optional)
PROVIDER_WEBHOOK_URL=https://example.com/webhook
LOW_BALANCE_THRESHOLD=1000000

# Request/response logging middleware. Set to 'false' to disable entirely.
# When enabled, all errors are logged and 10% of successful requests are sampled.
# Sensitive fields (secrets, tokens, passwords, API keys) are redacted. Default: true
LOG_REQUESTS=true
# Web Push configuration (optional; required to enable browser push notifications)
WEB_PUSH_VAPID_SUBJECT=mailto:alerts@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# CORS — comma-separated allowed origins. Use * to allow all (default for dev).
CORS_ORIGIN=http://localhost:5173,https://app.stellarsolargrid.io

# Rate limiting — window in ms and max requests per window.
# RATE_LIMIT_MAX is the single threshold for both the global /api read limiter
# and the general write limiter (default: 30). Payments have their own,
# stricter write limiter — see PAYMENTS_RATE_LIMIT_MAX below (default: 10).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
PAYMENTS_RATE_LIMIT_MAX=10

# Stellar RPC circuit breaker (#761) — trips after RPC_CIRCUIT_FAILURE_THRESHOLD
# consecutive failures (default: 5), stays open for RPC_CIRCUIT_RESET_MS
# (default: 30000 = 30s) before allowing a half-open trial request. While
# open, read-only queries fall back to the last successful cached result
# (RPC_QUERY_CACHE_MAX_ENTRIES entries kept, default: 500); writes and
# uncached queries fail fast with HTTP 503 (code CIRCUIT_OPEN) instead of
# hammering a struggling RPC endpoint. State is exported via
# /metrics (solargrid_rpc_circuit_breaker_state) and /health (rpcCircuitBreaker).
RPC_CIRCUIT_FAILURE_THRESHOLD=5
RPC_CIRCUIT_RESET_MS=30000
RPC_CIRCUIT_TIMEOUT_MS=20000
RPC_QUERY_CACHE_MAX_ENTRIES=500

# Fee safety margin (#762) — percentage padding added on top of the simulated
# resource fee for every submitted transaction. Simulation gives a
# point-in-time estimate; actual cost can drift by submission time, and the
# drift grows with how many ledger entries an operation touches (e.g. a
# batch_update_usage call over many meters), which is what causes
# "insufficient fee" on large batches without this margin. Set to 0 to disable.
RPC_FEE_SAFETY_MARGIN_PCT=20

# Distributed tracing (#763) — OpenTelemetry, off by default. Set OTEL_ENABLED=true
# (or just set OTEL_EXPORTER_OTLP_ENDPOINT) to export spans via OTLP/HTTP to a
# collector — e.g. Jaeger (`docker compose --profile observability up jaeger`,
# UI at http://localhost:16686) or an OTel Collector in front of Zipkin.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=solargrid-backend

# Admin auth failure rate limiting (#530)
# Dedicated limiter scoped to failed X-Admin-Key / Bearer token checks,
# independent of the general write limiter, to prevent brute-force attacks
# on the admin key without consuming write-limiter budget.
# Default: 10 failures per 15 minutes per IP.
ADMIN_FAIL_RATE_LIMIT_WINDOW_MS=900000
ADMIN_FAIL_RATE_LIMIT_MAX=10
